# AWS published-content reader (server/build only). Set these to the exact
# development reader outputs supplied privately by the admin staging rollout.
AWS_READER_ENVIRONMENT=dev
AWS_READER_REGION=
AWS_READER_FUNCTION_ARN=
AWS_READER_TIMEOUT_MS=10000

# Vercel Preview: enable OIDC and set the exact invoke-only development role.
# VERCEL_OIDC_TOKEN is supplied automatically by Vercel; do not store it here.
AWS_READER_ROLE_ARN=

# Local development only: temporary AWS profile with InvokeFunction on only
# the development reader. Leave unset on Vercel.
AWS_READER_PROFILE=

# Set by the image materialization step (issue #13) when published images exist.
AWS_READER_IMAGE_MANIFEST=
