# Supabase — server-only (no PUBLIC_ prefix; read at build time only)
# Required by src/lib/supabase.ts. astro build will fail fast if missing.
# In `pnpm dev`, an unreachable Supabase (network/query error) keeps the
# last-known content cache instead of failing — see README.md.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase project ID — used only by `pnpm types:gen` to regenerate
# src/lib/database.types.ts from the live schema. Not read at build/runtime.
SUPABASE_PROJECT_ID=
