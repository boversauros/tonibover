---
import Navigation from '@components/app/Navigation.astro';
import Link from '@components/ui/Link.astro';
import { defaultLang, useTranslations, type Lang } from '@/i18n';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Toni Bover</title>
  </head>
  <body class="min-h-screen bg-background text-primary font-sans antialiased flex flex-col">
    <Navigation lang={lang} currentPath={currentPath} />
    <slot />
  </body>
  <footer class="border-t border-subtle mt-auto">
    <div class="max-w-4xl mx-auto px-6 py-6">
      <div class="flex flex-col gap-4 md:flex-row md:justify-between md:items-center text-sm">
        <p class="text-muted font-serif">
          © Toni Bover, {new Date().getFullYear()}
        </p>
        <div class="flex flex-col gap-4 md:flex-row md:gap-6 text-muted">
          <Link href="/agraiments" variant="muted">{t('footer.acknowledgments')}</Link>
          <Link
            href="mailto:contact.webtonibover@gmail.com"
            variant="muted"
            aria-label="Contactar per correu electrònic">{t('footer.contact')}</Link
          >
          <Link
            href="/files/CAT_avis_proteccio.pdf"
            variant="muted"
            target="_blank"
            rel="noopener noreferrer">{t('footer.legal')}</Link
          >
        </div>
      </div>
    </div>
  </footer>
</html>
