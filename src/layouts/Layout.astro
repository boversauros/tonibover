---
import Navigation from '@components/app/Navigation.astro';
import Link from '@components/ui/Link.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Toni Bover</title>
  </head>
  <body class="min-h-screen bg-background text-primary font-sans antialiased flex flex-col">
    <Navigation />
    <slot />
  </body>
  <footer class="border-t border-subtle mt-auto">
    <div class="max-w-4xl mx-auto px-6 py-6">
      <div class="flex justify-between items-center text-sm">
        <p class="text-muted font-serif">
          © Toni Bover, {new Date().getFullYear()}
        </p>
        <p class="text-muted hover:text-body transition-colors-default">
          <Link href="#" variant="muted">Lleis d'autoria i protecció de dades</Link>
        </p>
      </div>
    </div>
  </footer>
</html>
