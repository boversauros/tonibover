---
import Layout from '@layouts/Layout.astro';
import Container from '@components/ui/Container.astro';
import PreambulNavigation from '@components/app/PreambulNavigation.astro';
import Image from '@components/ui/Image.astro';
import Icon from '@components/ui/Icon.astro';
import Link from '@/components/ui/Link.astro';
import Text from '@components/ui/Text.astro';
import { useTranslations, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
  title: string;
  quote?: string;
  image: {
    src: string;
    alt: string;
    caption?: string;
  };
}

const { lang, title, quote, image } = Astro.props;
const t = useTranslations(lang);
const currentSection = Astro.url.pathname.replace(/\/$/, '').split('/').pop() || '';
---

<Layout lang={lang}>
  <Container>
    <h1 class="text-3xl font-serif text-secondary mb-sp-8 font-semibold">{title}</h1>

    <div class="space-y-sp-10">
      <div class="prose max-w-none">
        <slot />
      </div>

      <div class="w-full">
        <Image src={image.src} alt={image.alt} aspect="auto" hover="none">
          {image.caption && <span slot="caption">{image.caption}</span>}
        </Image>
      </div>

      {
        quote && (
          <blockquote class="flex gap-sp-4 py-sp-2 my-sp-8">
            <Icon name="quote-close" class="h-10 w-10 md:h-12 md:w-12 text-secondary shrink-0 mt-1" />
            <p class="text-xl font-serif text-secondary italic">{quote}</p>
          </blockquote>
        )
      }
      <div class="mt-sp-4 space-y-sp-2">
        <Link
          href="https://raco.cat/index.php/TempsEducacio/article/view/400669"
          target="_blank"
          rel="noopener noreferrer"
          variant="muted"
          class="block"
        >
          <Text variant="muted" class="hover:text-primary transition-colors-default">
            {t('preambul.articleLink')}
          </Text>
        </Link>
        {lang === 'en' && (
          <Link
            href="/files/Toni%20Article_204060_ENG.pdf"
            target="_blank"
            rel="noopener noreferrer"
            variant="muted"
            class="block"
          >
            <Text variant="muted" class="text-sm hover:text-primary transition-colors-default">
              {t('preambul.articleTranslationLink')}
            </Text>
          </Link>
        )}
      </div>

      <PreambulNavigation lang={lang} currentSection={currentSection} />
    </div>
  </Container>
</Layout>
