---
import Layout from '@layouts/Layout.astro';
import PreambulNavigation from '@components/app/PreambulNavigation.astro';
import Image from '@components/ui/Image.astro';
import Link from '@/components/ui/Link.astro';
import Text from '@components/ui/Text.astro';

interface Props {
  title: string;
  subtitle: string;
  quote?: string;
  image: {
    src: string;
    alt: string;
    caption?: string;
  };
}

const { title, subtitle, quote, image } = Astro.props;
const currentSection = Astro.url.pathname.replace(/\/$/, '').split('/').pop() || '';
---

<Layout>
  <main class="grow pt-32 pb-16">
    <div class="max-w-4xl mx-auto px-6">
      <div class="border-b border-subtle pb-8 mb-12">
        <h1 class="text-3xl font-serif text-secondary mb-4">{title}</h1>
        <p class="text-lg text-body">{subtitle}</p>
        <Link
          href="https://raco.cat/index.php/TempsEducacio/article/view/400669"
          target="_blank"
          rel="noopener noreferrer"
          variant="muted"
          class="mt-4 block"
        >
          <Text variant="small" italic class="hover:text-primary transition-colors-default">
            Article: 20/40/60. Una reflexió iconotextual de la fotografia com a art i ciència. Temps
            d’Educació, UB. 2021
          </Text>
        </Link>
      </div>

      <div class="space-y-12">
        <div class="prose max-w-none">
          <slot />
        </div>

        <div class="w-full">
          <Image src={image.src} alt={image.alt} aspect="auto" hover="none">
            {image.caption && <span slot="caption">{image.caption}</span>}
          </Image>
        </div>

        {
          quote && (
            <blockquote class="border-l-4 border-accent pl-6 py-2 my-8">
              <p class="text-xl font-serif text-secondary italic">{quote}</p>
            </blockquote>
          )
        }

        <PreambulNavigation currentSection={currentSection} />
      </div>
    </div>
  </main>
</Layout>
