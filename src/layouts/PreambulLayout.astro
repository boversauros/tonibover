---
import Layout from '@layouts/Layout.astro';
import PreambulNavigation from '@components/app/PreambulNavigation.astro';
import Image from '@components/ui/Image.astro';
import Link from '@/components/ui/Link.astro';
import Text from '@components/ui/Text.astro';
import { useTranslations, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
  title: string;

  quote?: string;
  image: {
    src: string;
    alt: string;
    caption?: string;
  };
}

const { lang, title, quote, image } = Astro.props;
const t = useTranslations(lang);
const currentSection = Astro.url.pathname.replace(/\/$/, '').split('/').pop() || '';
---

<Layout lang={lang}>
  <main class="grow container-spacing-default">
    <div class="max-w-4xl mx-auto px-sp-6">
      <Text variant="body" class="text-lg">
        {t('preambul.intro2')}
      </Text>
      <h1 class="text-3xl font-serif text-secondary my-sp-8 font-semibold">{title}</h1>

      <div class="space-y-sp-10">
        <div class="prose max-w-none">
          <slot />
        </div>

        <div class="w-full">
          <Image src={image.src} alt={image.alt} aspect="auto" hover="none">
            {image.caption && <span slot="caption">{image.caption}</span>}
          </Image>
        </div>

        {
          quote && (
            <blockquote class="border-l-4 border-accent pl-sp-6 py-sp-2 my-sp-8">
              <p class="text-xl font-serif text-secondary italic">{quote}</p>
            </blockquote>
          )
        }
        <Link
          href="https://raco.cat/index.php/TempsEducacio/article/view/400669"
          target="_blank"
          rel="noopener noreferrer"
          variant="muted"
          class="mt-sp-4 block"
        >
          <Text variant="muted" class="hover:text-primary transition-colors-default">
            {t('preambul.articleLink')}
          </Text>
        </Link>

        <PreambulNavigation lang={lang} currentSection={currentSection} />
      </div>
    </div>
  </main>
</Layout>
