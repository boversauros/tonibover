---
import PreambulContentLayout from '@layouts/PreambulLayout.astro';
import Text from '@components/ui/Text.astro';
import '@styles/global.css';

const image = {
  src: '/images/preambul-20-02.webp',
  alt: 'Dos fotografies, Toni Bover fent una foto i aguantant una càmera',
  caption: 'Fotografies Arxiu Familiar i Pere Moscoso. Anys 70 i 80 del segle XX',
};
---

<PreambulContentLayout
  title="UN PROCÉS TRANS A LA MADURESA"
  subtitle="Els 20 simbolitzen l’edat de la il·lusió, quan la mirada s’orienta cap al futur. Aquestes il·lusions i idees m’han acompanyat al llarg de la vida."
  quote="Entendre la imatge fotogràfica és imprescindible per a l’alfabetització iconotextual i la comunicació visual."
  image={image}
>
  <Text variant="body">
    L’interès per les matemàtiques i la filosofia va anar derivant cap a la semiòtica de la imatge.
  </Text>

  <Text variant="body">
    Familiaritzar-me amb la fotografia em va permetre aprendre a mirar, comunicar idees a partir
    dels signes icònics i a ordenar els elements de la imatge per comprendre els principis de
    l’estètica i de la comunicació visual.
  </Text>
</PreambulContentLayout>
