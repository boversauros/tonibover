---
import PreambulContentLayout from '@layouts/PreambulLayout.astro';
import Text from '@components/ui/Text.astro';
import { useTranslations } from '@/i18n';
import '@styles/global.css';

const t = useTranslations('ca');

const image = {
  src: '/images/preambul-60-02.webp',
  alt: t('preambul.60.imageAlt'),
  caption: t('preambul.60.imageCaption'),
};
---

<PreambulContentLayout
  lang="ca"
  title={`60 ${t('preambul.60.title')}`}
  subtitle={t('preambul.60.subtitle')}
  quote={t('preambul.60.quote')}
  image={image}
>
  <Text variant="body">
    {t('preambul.60.paragraph1')}
  </Text>

  <Text variant="body">
    {t('preambul.60.paragraph2')}
  </Text>
</PreambulContentLayout>
