---
import Layout from '@layouts/Layout.astro';
import Link from '@components/ui/Link.astro';
import SectionTitle from '@components/ui/SectionTitle.astro';
import Heading from '@components/ui/Heading.astro';
import Text from '@components/ui/Text.astro';
import '@styles/global.css';
---

<Layout>
  <main class="flex-grow pt-32 pb-16">
    <div class="max-w-4xl mx-auto px-6">
      <SectionTitle>PREÀMBUL</SectionTitle>

      <div class="mb-16">
        <Text variant="body">
          Els 20/40/60 són períodes temporals exactes, són processos de les capacitats
          d'aprenentatge de cada persona.
        </Text>
        <Text variant="small" italic class="mt-4">
          Article 20/40/60: Una reflexió sistemàtica de la fotografia com art i cultura, 2020.
        </Text>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <Link href="/preambul/20" class="group block">
          <div class="space-y-4">
            <img
              src="https://picsum.photos/400/300"
              alt="Un procés trans a la màquina"
              class="w-full aspect-square object-cover transition-opacity duration-700 group-hover:opacity-90"
            />
            <div class="space-y-2">
              <Heading as="span" size="3xl" variant="secondary" class="block">20</Heading>
              <Heading as="h3" size="2xl" variant="secondary" class="mb-0">UN PROCÉS TRANS A LA MÀQUINA</Heading>
              <Text variant="small" class="group-hover:text-body transition-colors">
                Descobrir més →
              </Text>
            </div>
          </div>
        </Link>

        <Link href="/preambul/40" class="group block">
          <div class="space-y-4">
            <img
              src="https://picsum.photos/400/300"
              alt="Un procés trans de l'analògic al digital"
              class="w-full aspect-square object-cover transition-opacity duration-700 group-hover:opacity-90"
            />
            <div class="space-y-2">
              <Heading as="span" size="3xl" variant="secondary" class="block">40</Heading>
              <Heading as="h3" size="2xl" variant="secondary" class="mb-0">
                UN PROCÉS TRANS DE L'ANALÒGIC AL DIGITAL
              </Heading>
              <Text variant="small" class="group-hover:text-body transition-colors">
                Descobrir més →
              </Text>
            </div>
          </div>
        </Link>

        <Link href="/preambul/60" class="group block">
          <div class="space-y-4">
            <img
              src="https://picsum.photos/400/300"
              alt="Un procés trans laboral"
              class="w-full aspect-square object-cover transition-opacity duration-700 group-hover:opacity-90"
            />
            <div class="space-y-2">
              <Heading as="span" size="3xl" variant="secondary" class="block">60</Heading>
              <Heading as="h3" size="2xl" variant="secondary" class="mb-0">UN PROCÉS TRANS LABORAL</Heading>
              <Text variant="small" class="group-hover:text-body transition-colors">
                Descobrir més →
              </Text>
            </div>
          </div>
        </Link>
      </div>
    </div>
  </main>
</Layout>
