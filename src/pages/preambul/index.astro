---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
---

<Layout>
  <main class="flex-grow pt-32 pb-16">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-xl font-serif italic mb-8 text-gray-200">PREÀMBUL</h2>

      <div class="mb-16">
        <p class="text-base leading-relaxed text-gray-300">
          Els 20/40/60 són períodes temporals exactes, són processos de les capacitats
          d'aprenentatge de cada persona.
        </p>
        <p class="text-sm text-gray-400 mt-4 italic">
          Article 20/40/60: Una reflexió sistemàtica de la fotografia com art i cultura, 2020.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <a href="/preambul/20" class="group">
          <div class="space-y-4">
            <img
              src="https://placehold.co/400x300"
              alt="Un procés trans a la màquina"
              class="w-full aspect-square object-cover transition-opacity duration-700 group-hover:opacity-90"
            />
            <div class="space-y-2">
              <span class="text-3xl font-serif text-gray-200">20</span>
              <h3 class="text-lg font-serif text-gray-200">UN PROCÉS TRANS A LA MÀQUINA</h3>
              <p class="text-sm text-gray-400 group-hover:text-gray-300 transition-colors">
                Descobrir més →
              </p>
            </div>
          </div>
        </a>

        <a href="/preambul/40" class="group">
          <div class="space-y-4">
            <img
              src="https://placehold.co/400x300"
              alt="Un procés trans de l'analògic al digital"
              class="w-full aspect-square object-cover transition-opacity duration-700 group-hover:opacity-90"
            />
            <div class="space-y-2">
              <span class="text-3xl font-serif text-gray-200">40</span>
              <h3 class="text-lg font-serif text-gray-200">
                UN PROCÉS TRANS DE L'ANALÒGIC AL DIGITAL
              </h3>
              <p class="text-sm text-gray-400 group-hover:text-gray-300 transition-colors">
                Descobrir més →
              </p>
            </div>
          </div>
        </a>

        <a href="/preambul/60" class="group">
          <div class="space-y-4">
            <img
              src="https://placehold.co/400x300"
              alt="Un procés trans laboral"
              class="w-full aspect-square object-cover transition-opacity duration-700 group-hover:opacity-90"
            />
            <div class="space-y-2">
              <span class="text-3xl font-serif text-gray-200">60</span>
              <h3 class="text-lg font-serif text-gray-200">UN PROCÉS TRANS LABORAL</h3>
              <p class="text-sm text-gray-400 group-hover:text-gray-300 transition-colors">
                Descobrir més →
              </p>
            </div>
          </div>
        </a>
      </div>
    </div>
  </main>
</Layout>
