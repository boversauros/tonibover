---
import Layout from '@layouts/Layout.astro';
import Container from '@components/ui/Container.astro';
import Card from '@components/ui/Card.astro';
import SectionTitle from '@components/ui/SectionTitle.astro';
import Heading from '@components/ui/Heading.astro';
import Text from '@components/ui/Text.astro';
import Image from '@components/ui/Image.astro';
import Link from '@/components/ui/Link.astro';
import '@styles/global.css';
---

<Layout>
  <Container>
    <SectionTitle>PREÀMBUL</SectionTitle>

    <div class="mb-16">
      <Text variant="body" class="mb-4">
        Aquesta web és un relat interactiu, subjectiu i amb components autobiogràfics sobre l’image
        management. Hi descric l’aprenentatge i l’autoaprenentatge de la comunicació visual dels
        darrers 40 anys.
      </Text>
      <Text variant="body">
        Els 20, els 40 i els 60 no són períodes temporals exactes, sinó processos de transició que
        depenen de les actituds i de les capacitats d’aprenentatge de cada persona.
      </Text>
      <Link
        href="https://raco.cat/index.php/TempsEducacio/article/view/400669"
        target="_blank"
        rel="noopener noreferrer"
        variant="muted"
        class="mt-4 block"
      >
        <Text variant="small" italic class="hover:text-primary transition-colors-default">
          Article: 20/40/60. Una reflexió iconotextual de la fotografia com a art i ciència. Temps
          d’Educació, UB. 2021
        </Text>
      </Link>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <Card href="/preambul/20" aria-label="Descobrir més sobre procés trans a la màquina">
        <Image
          slot="image"
          src="/images/preambul-20-01.webp"
          alt="Un procés trans a la màquina"
          aspect="square"
          hover="opacity"
        />
        <div class="space-y-2">
          <span class="block text-3xl font-serif text-secondary">20</span>
          <Heading as="h3" size="2xl" variant="secondary" class="mb-0"
            >UN PROCÉS TRANS A LA MADURESA</Heading
          >
          <Text variant="small" class="group-hover:text-body transition-colors">
            Descobrir més →
          </Text>
        </div>
      </Card>

      <Card
        href="/preambul/40"
        aria-label="Descobrir més sobre procés trans de l'analògic al digital"
      >
        <Image
          slot="image"
          src="/images/preambul-40-01.webp"
          alt="Un procés trans de l'analògic al digital"
          aspect="square"
          hover="opacity"
        />
        <div class="space-y-2">
          <span class="block text-3xl font-serif text-secondary">40</span>
          <Heading as="h3" size="2xl" variant="secondary" class="mb-0">
            UN PROCÉS TRANS DE L’ANALÒGIC AL DIGITAL
          </Heading>
          <Text variant="small" class="group-hover:text-body transition-colors">
            Descobrir més →
          </Text>
        </div>
      </Card>

      <Card href="/preambul/60" aria-label="Descobrir més sobre procés trans laboral">
        <Image
          slot="image"
          src="/images/preambul-60-01.webp"
          alt="Un procés trans laboral"
          aspect="square"
          hover="opacity"
        />
        <div class="space-y-2">
          <span class="block text-3xl font-serif text-secondary">60</span>
          <Heading as="h3" size="2xl" variant="secondary" class="mb-0"
            >UN PROCÉS TRANS LABORAL</Heading
          >
          <Text variant="small" class="group-hover:text-body transition-colors">
            Descobrir més →
          </Text>
        </div>
      </Card>
    </div>
  </Container>
</Layout>
