---
import PreambulContentLayout from '@layouts/PreambulLayout.astro';
import Text from '@components/ui/Text.astro';
import '@styles/global.css';

const image = {
  src: '/images/preambul-40-02.webp',
  alt: 'Dos fotografies, Toni Bover en un despatx i un grup de persones en una oficina',
  caption:
    'Fotografies Frank Gómez i Miquel Bigas. Anys 90 del segle XX i primera dècada del segle XXI',
};
---

<PreambulContentLayout
  title="UN PROCÉS TRANS DE L'ANALÒGIC AL DIGITAL"
  subtitle="Els 40 obren l’etapa de la maduresa i de la millora continua, moment en què prenc consciència del que estimo i on es consoliden les idees dels 20. Aquesta fase serveix per entendre i aprofundir els coneixements sobre la fotografia i la seva relació amb la comunicació visual."
  articleInfo="Article 20/40/60: Una reflexió sistemàtica de la fotografia com art i cultura, 2020"
  quote="La fotografia ha estat un pas entre el dibuix en perspectiva i el CGI d’estètica realista."
  image={image}
>
  <Text variant="body">
    Treballar deu anys professionalment en fotografia industrial em va permetre assimilar les bases
    de la tecnologia fotogràfica i de la física de la llum. Mitjançant la il·luminació vaig aprendre
    a descriure les formes i les textures dels objectes.
  </Text>

  <Text variant="body">
    L’entrada com a professor a la Universitat i fer el doctorat a l’Escola d’Arquitectura em va
    facilitar comprendre i aplicar els principis de la perspectiva i de la geometria de la imatge, i
    interessar-me per les relacions entre el dibuix, la fotografia i la imatge generada per
    ordinador (CGI).
  </Text>
</PreambulContentLayout>
