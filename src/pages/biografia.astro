---
import Layout from '@layouts/Layout.astro';
import Container from '@components/ui/Container.astro';
import Carousel from '@components/app/Carousel.astro';
import Link from '@components/ui/Link.astro';
import SectionTitle from '@components/ui/SectionTitle.astro';
import Heading from '@components/ui/Heading.astro';
import Text from '@components/ui/Text.astro';
import '@styles/global.css';
---

<Layout>
  <Container>
    <SectionTitle>BIOGRAFIA</SectionTitle>
    <Heading as="h1" size="3xl" variant="primary">Antoni Bover Tanyà</Heading>
    <Text variant="body" class="text-lg text-primary-80 mb-8">Vic, 15 de juny de 1954</Text>

    <Carousel />

    <div class="mt-12 text-sm text-primary-60 italic">
      Fotografies Arxiu Familiar, Dolors Vila i Miquel Bigas, 1957-2020.
    </div>

    <div class="mt-16 space-y-12">
      <section>
        <Heading as="h3" size="2xl" variant="primary">Formació acadèmica</Heading>
        <ul class="space-y-4 text-primary-80">
          <li>
            Doctor per la Universitat Politècnica de Catalunya (UPC), <em>Cum Laude</em>, en
            Comunicació Visual en arquitectura i disseny (2011).
            <Link
              href="https://upcommons.upc.edu/handle/2117/94778?show=full"
              aria-label="Tesi doctoral Toni Bover"
              rel="noopener noreferrer"
              target="_blank"
              variant="secondary"
              >Tesi doctoral
            </Link>
          </li>
          <li>
            Estudis de Semiòtica de la Imatge, Université Paris 8 Vincennes–Saint Denis (1983-1984).
          </li>
          <li>Llicenciat en Filosofia i Lletres per la Universitat de Barcelona (1977).</li>
        </ul>
      </section>

      <section>
        <Heading as="h3" size="2xl" variant="primary">Activitat docent i acadèmica</Heading>
        <ul class="space-y-4 text-primary-80">
          <li>
            Professor al CITM/UPC Terrassa en il·luminació, fotografia, CGI i fotografia
            d’arquitectura i espais urbans (1994-2020).
          </li>
          <li>
            Fundador i coordinador del Laboratori CGI (Computer Generated Imagery) del CITM/UPC
            Terrassa (2005-2015).
          </li>
          <li>
            Director del postgrau Espai Virtual: de la Fotografia a la Realitat Augmentada, CITM/UPC
            School (2015-2016).
          </li>
          <li>Director del postgrau Fotografia i CGI, CITM/UPC School (2011-2014).</li>
          <li>
            Professor col·laborador a l’ETSAB/UPC Barcelona en fotografia d’arquitectura
            (1998-2001).
          </li>
        </ul>
      </section>

      <section>
        <Heading as="h2" size="2xl" variant="primary">Gestió cultural i projectes educatius</Heading
        >
        <ul class="space-y-4 text-primary-80">
          <li>
            Director de La Farinera, Centre d’Arts Visuals de Vic (Ajuntament de Vic) (2010-2020).
          </li>
          <li>Codirector de la Fundació Educació i Art (Ajuntament de Vic) (2014-2020).</li>
          <li>
            Coordinador del projecte Ciutats invisibles, La Farinera Centre d’Activitats
            (2010-2020).
          </li>
          <li>
            Coordinador del projecte Fotografia històrica, Escola Casa Masferrer (Ajuntament de Vic)
            (1996-2010).
          </li>
          <li>Professor de fotografia a l’Escola Municipal de Dibuix de Vic (1980-1996).</li>
        </ul>
      </section>

      <section>
        <Heading as="h2" size="2xl" variant="primary">Activitat institucional</Heading>
        <ul class="space-y-4 text-primary-80">
          <li>
            Membre del Consell Assessor Territorial de la Catalunya Central (Departament de Cultura,
            Generalitat de Catalunya) (2016-2017).
          </li>
          <li>Membre del Consell de Cultura de l’Ajuntament de Vic (2012-2015).</li>
          <li>Membre del Consell de Cultura de l’Ajuntament de Terrassa (2008-2014).</li>
          <li>Membre del Patronat de la Ciutat Antiga de l’Ajuntament de Vic (2007-2013).</li>
        </ul>
      </section>

      <section>
        <Heading as="h2" size="2xl" variant="primary">Altres activitats</Heading>
        <ul class="space-y-4 text-primary-80">
          <li>Fotògraf professional especialitzat en fotografia industrial (1985-1994).</li>
          <li>
            Reflexió i recerca sobre comunicació textual i visual des del perspectivisme (des del
            2020).
          </li>
        </ul>
      </section>
    </div>
  </Container>
</Layout>
