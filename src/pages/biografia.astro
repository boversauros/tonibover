---
import Layout from '@layouts/Layout.astro';
import Container from '@components/ui/Container.astro';
import Carousel from '@components/app/Carousel.astro';
import Link from '@components/ui/Link.astro';
import SectionTitle from '@components/ui/SectionTitle.astro';
import Heading from '@components/ui/Heading.astro';
import Text from '@components/ui/Text.astro';
import '@styles/global.css';
---

<Layout>
  <Container>
    <SectionTitle>BIOGRAFIA</SectionTitle>
    <Heading as="h1" size="4xl" variant="primary">Antoni Bover Tanyà</Heading>
    <Text variant="body" class="text-lg text-primary-80 mb-8">Vic, 15 de juny de 1954</Text>
    <Text variant="body" class="text-primary-60 mb-12"
      >Especialista en Image Management (comunicació visual)</Text
    >

    <Carousel />

    <div class="mt-12 text-sm text-primary-60 italic">
      Fotografies Arxiu Familiar, Dolors Vila i Miquel Bigas, 1957-2020.
    </div>

    <div class="mt-16 space-y-12">
      <section>
        <Heading as="h3" size="2xl" variant="primary">Formació Acadèmica</Heading>
        <ul class="space-y-4 text-primary-80">
          <li>
            Doctor UPC, <em>Cum Laude</em>, en Comunicació Visual en arquitectura i disseny, any
            2011.
            <Link href="#" variant="secondary">Tesi doctoral</Link>
          </li>
          <li>
            Estudis de Semiòtica de la Imatge, Université Paris 8-Vincennes-Saint Denis, curs
            1983-1984.
          </li>
          <li>Llicenciat UB en Filosofia i Lletres, any 1977.</li>
        </ul>
      </section>

      <section>
        <Heading as="h3" size="2xl" variant="primary">Activitats Docents</Heading>
        <ul class="space-y-4 text-primary-80">
          <li>
            Professor CITM / UPC Terrassa: Il·luminació, Fotografia i CGI, Fotografia
            d'Arquitectura i Espais Urbans. 1994-2020.
          </li>
          <li>
            Fundador i coordinador del Laboratori CGI (Computer Generated Imagery) en el CITM /
            UPC Terrassa. 2005-2015.
          </li>
          <li>
            Director del Postgrau CITM / UPC School: Espai Virtual: De la fotografia a la Realitat
            Augmentada. 2015-2016.
          </li>
          <li>Director del Postgrau CITM / UPC School: Fotografia i CGI. 2011-2014.</li>
          <li>
            Professor Col·laborador ETSAB / UPC Barcelona: Fotografia d'Arquitectura. 1998-2001.
          </li>
          <li>Codirecció de la "Fundació Educació i Art" (Ajuntament de Vic). 2014-2020</li>
          <li>
            Director de La Farinera, Centre d'Arts Visuals de Vic (Ajuntament de Vic). 2010-2020
          </li>
          <li>Coordinador "Ciutats Invisibles" a La Farinera_Centre d'Activitats. 2010-2020.</li>
          <li>
            Coordinador "Fotografia Històrica" a l'Escola Casa Masferrer (Ajuntament de Vic).
            1996-2010.
          </li>
        </ul>
      </section>

      <section>
        <Heading as="h2" size="2xl" variant="primary">Experiència Professional</Heading>
        <ul class="space-y-4 text-primary-80">
          <li>
            Membre del "Consell Assessor Territorial de la Catalunya Central" (Departament de
            Cultura de la Generalitat de Catalunya). 2016-2017.
          </li>
          <li>Membre del Consell de Cultura de l'Ajuntament de Vic. 2012-2015</li>
          <li>Membre del Consell de Cultura de l'Ajuntament de Terrassa. 2008-2014</li>
          <li>Membre del Patronat de la Ciutat Antiga de l'Ajuntament de Vic. 2007-2013.</li>
        </ul>
      </section>
    </div>
  </Container>
</Layout>
