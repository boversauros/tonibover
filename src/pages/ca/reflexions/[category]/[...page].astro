---
import '@styles/global.css';
import Layout from '@layouts/Layout.astro';
import PostsListLayout from '@layouts/PostsListLayout.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPathsOptions } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const categoryEntries = await getCollection('categories');
  const categories = categoryEntries
    .map((c) => ({ id: c.data.slug, name: c.data.name }))
    .sort((a, b) => a.name.localeCompare(b.name, 'ca'));

  const posts = await getCollection('posts');
  const pageSize = 6;

  return categories.flatMap(({ id }) => {
    const categoryPosts = posts.filter((post) => post.data.category === id);
    return paginate(categoryPosts, {
      params: { category: id },
      props: { categories },
      pageSize,
    });
  });
}

const { page, categories } = Astro.props;
const { category } = Astro.params;
const categoryName = categories.find((c) => c.id === category)?.name;
const uniqueKeywords = [...new Set(page.data.flatMap((post) => post.data.keywords))];
---

<Layout>
  <PostsListLayout
    title={`REFLEXIONS: ${categoryName}`}
    categories={categories}
    page={page}
    keywords={uniqueKeywords}
    activeCategory={category}
  />
</Layout>
