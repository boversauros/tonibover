---
import '@styles/global.css';
import Layout from '@layouts/Layout.astro';
import PostsListLayout from '@layouts/PostsListLayout.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPathsOptions } from 'astro';
import { useTranslations, getLocalizedPath } from '@/i18n';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const categoryEntries = await getCollection('categories');
  const categories = categoryEntries
    .map((c) => ({ id: c.data.slug, name: c.data.name.ca }))
    .sort((a, b) => a.name.localeCompare(b.name, 'ca'));

  const posts = await getCollection('posts', ({ data }) => data.lang === 'ca');
  const pageSize = 6;

  return categories.flatMap(({ id }) => {
    const categoryPosts = posts.filter((post) => post.data.category === id);
    return paginate(categoryPosts, {
      params: { category: id },
      props: { categories },
      pageSize,
    });
  });
}

const { page, categories } = Astro.props;
const { category } = Astro.params;
const t = useTranslations('ca');
const categoryName = categories.find((c) => c.id === category)?.name;
---

<Layout>
  <PostsListLayout
    title={`${t('nav.reflexions')}: ${categoryName}`}
    categories={categories}
    page={page}
    activeCategory={category}
    emptyMessage={t('reflexions.empty.category')}
    indexHref={getLocalizedPath('/reflexions/index', 'ca')}
    indexLabel={t('nav.index')}
  />
</Layout>
