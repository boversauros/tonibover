---
import '@styles/global.css';
import Layout from '@layouts/Layout.astro';
import PostsListLayout from '@layouts/PostsListLayout.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPathsOptions } from 'astro';
import { useTranslations } from '@/i18n';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const [posts, keywordEntries] = await Promise.all([
    getCollection('posts', ({ data }) => data.lang === 'ca'),
    getCollection('keywords', ({ data }) => data.lang === 'ca'),
  ]);
  const pageSize = 6;

  return keywordEntries.flatMap((kw) => {
    const ids = new Set(kw.data.postIds);
    const keywordPosts = posts.filter((p) => ids.has(p.id));
    return paginate(keywordPosts, {
      params: { keyword: kw.data.slug },
      props: { label: kw.data.label },
      pageSize,
    });
  });
}

const { label, page } = Astro.props;
const t = useTranslations('ca');

const categoryEntries = await getCollection('categories');
const categories = categoryEntries
  .map((c) => ({ id: c.data.slug, name: c.data.name.ca }))
  .sort((a, b) => a.name.localeCompare(b.name, 'ca'));

const uniqueKeywords = [...new Set(page.data.flatMap((post) => post.data.keywords))];
---

<Layout>
  <PostsListLayout
    title={`${t('nav.reflexions')}: ${t('reflexions.keywordPrefix')} "${label}"`}
    categories={categories}
    page={page}
    keywords={uniqueKeywords}
    emptyMessage={t('reflexions.empty.keyword')}
  />
</Layout>
