---
import '@styles/global.css';
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Container from '@components/ui/Container.astro';
import KeywordsList from '@components/composed/KeywordsList.astro';
import Link from '@components/ui/Link.astro';
import Heading from '@components/ui/Heading.astro';
import Image from '@components/ui/Image.astro';
import type { Post } from '@/types';
import { getLocalizedPath } from '@/i18n';

export async function getStaticPaths() {
  const posts: Post[] = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;

const categories = [
  { id: 'influencies', name: 'Influències' },
  { id: 'perspectives', name: 'Perspectives' },
  { id: 'vivencies', name: 'Vivències' },
];

const categoryName = categories.find((c) => c.id === post.data.category)?.name;
---

<Layout>
  <Container>
    <!-- Navigation breadcrumb -->
    <nav class="mb-sp-12">
      <ol class="flex items-center space-x-sp-2 text-sm text-muted">
        <li>
          <Link
            href={getLocalizedPath('/reflexions', 'ca')}
            variant="muted"
            class="hover:text-white">Reflexions</Link
          >
        </li>
        <li>/</li>
        <li>
          <Link
            href={getLocalizedPath(`/reflexions/${post.data.category}`, 'ca')}
            variant="muted"
            class="hover:text-white"
          >
            {categoryName}
          </Link>
        </li>
      </ol>
    </nav>

    <article class="space-y-sp-16">
      <!-- Header -->
      <header class="space-y-sp-6">
        <Heading as="h1" size="3xl" variant="primary" class="leading-tight">
          {post.data.title}
        </Heading>
      </header>

      <!-- Hero image (optional) -->
      {
        post.data.image && (
          <figure class="space-y-sp-8">
            <Image
              src={post.data.image.url}
              alt={post.data.image.alt}
              height="h-[400px]"
              hover="none"
              loading="eager"
            >
              <span slot="caption">{post.data.image.alt}</span>
            </Image>
          </figure>
        )
      }

      <!-- Content -->
      <div
        class="prose prose-xl max-w-none prose-headings:font-serif prose-headings:text-primary prose-p:text-body prose-p:leading-relaxed prose-p:text-lg"
      >
        <Fragment set:html={post.data.html} />
      </div>

      <!-- References -->
      {
        post.data.references.length > 0 && (
          <section class="border-t border-default pt-sp-10 space-y-sp-6">
            <Heading as="h2" size="xl" variant="secondary">
              Referències
            </Heading>
            <ul class="space-y-sp-4 text-sm text-muted leading-relaxed">
              {post.data.references.map((ref) => (
                <li class="pl-sp-4">
                  <span class="text-body mr-2">-</span>
                  <span>{ref.reference}</span>
                  {ref.blockquote && (
                    <blockquote class="mt-sp-2 ml-sp-4 italic border-l border-default pl-sp-3">
                      {ref.blockquote}
                    </blockquote>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <!-- Keywords -->
      <KeywordsList keywords={post.data.keywords} />
    </article>
  </Container>
</Layout>
