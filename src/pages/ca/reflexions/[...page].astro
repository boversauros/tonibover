---
import '@styles/global.css';
import Layout from '@layouts/Layout.astro';
import PostsListLayout from '@layouts/PostsListLayout.astro';
import { getCollection } from 'astro:content';
import type { Post } from '@/types';
import type { GetStaticPathsOptions } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts: Post[] = await getCollection('posts');
  return paginate(posts, { pageSize: 6 });
}

const { page } = Astro.props;

const categoryEntries = await getCollection('categories');
const categories = categoryEntries
  .map((c) => ({ id: c.data.slug, name: c.data.name }))
  .sort((a, b) => a.name.localeCompare(b.name, 'ca'));

const uniqueKeywords = [...new Set(page.data.flatMap((post) => post.data.keywords))];
---

<Layout>
  <PostsListLayout
    title="REFLEXIONS"
    categories={categories}
    page={page}
    keywords={uniqueKeywords}
  />
</Layout>
