---
import '@styles/global.css';
import Layout from '@layouts/Layout.astro';
import PostsListLayout from '@layouts/PostsListLayout.astro';
import { getCollection } from 'astro:content';
import type { Post } from '@/types';
import type { GetStaticPathsOptions } from 'astro';
import { useTranslations, getLocalizedPath } from '@/i18n';
import { emptyPage } from '@/lib/empty-page';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts: Post[] = await getCollection('posts', ({ data }) => data.lang === 'ca');
  if (posts.length === 0) {
    return [{ params: { page: undefined }, props: { page: emptyPage<Post>('/ca/reflexions') } }];
  }
  return paginate(posts, { pageSize: 6 });
}

const { page } = Astro.props;
const t = useTranslations('ca');

const categoryEntries = await getCollection('categories');
const categories = categoryEntries
  .map((c) => ({ id: c.data.slug, name: c.data.name.ca }))
  .sort((a, b) => a.name.localeCompare(b.name, 'ca'));
---

<Layout>
  <PostsListLayout
    title={t('nav.reflexions')}
    categories={categories}
    page={page}
    emptyMessage={t('reflexions.empty')}
    indexHref={getLocalizedPath('/reflexions/index', 'ca')}
    indexLabel={t('nav.index')}
  />
</Layout>
