---
import '@fontsource-variable/bodoni-moda';
import '@fontsource/nunito/300.css';
import '@fontsource/nunito/400.css';
import '@styles/global.css';
import Link from '@components/ui/Link.astro';
import Image from '@components/ui/Image.astro';
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Toni Bover</title>
  </head>
  <body class="min-h-screen bg-background text-primary font-sans antialiased">
    <main
      id="lang-page"
      class="flex items-center justify-center min-h-svh opacity-0 transition-opacity duration-700"
    >
      <div class="max-w-lg mx-auto px-sp-6 text-center">
        <h1 class="text-5xl font-serif italic font-semibold text-primary mb-sp-3">Toni Bover</h1>
        <p class="text-sm tracking-[0.3em] text-muted mb-sp-6">IMAGE MANAGER</p>

        <div class="max-w-[485px] max-h-[580px] mx-auto mb-sp-10">
          <Image
            src="/images/lang_selector.webp"
            alt="Toni Bover"
            hover="none"
            loading="eager"
            class="max-h-[45svh] object-contain mx-auto"
          />
        </div>

        <nav class="flex items-center justify-center gap-sp-8 mt-sp-6">
          <Link href="/ca/" underline data-lang="ca" class="text-lg tracking-wide">
            Catal&agrave;
          </Link>
          <span class="text-subtle">/</span>
          <Link href="/en/" underline data-lang="en" class="text-lg tracking-wide">
            English
          </Link>
        </nav>
      </div>
    </main>

    <script>
      const page = document.getElementById('lang-page');
      const preferredLang = localStorage.getItem('preferred-lang');

      if (preferredLang === 'ca' || preferredLang === 'en') {
        window.location.replace(`/${preferredLang}/`);
      } else {
        page?.classList.remove('opacity-0');
      }

      document.querySelectorAll<HTMLAnchorElement>('[data-lang]').forEach((link) => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const lang = link.dataset.lang;
          if (lang) {
            localStorage.setItem('preferred-lang', lang);
            window.location.href = `/${lang}/`;
          }
        });
      });
    </script>
  </body>
</html>
