---
import Layout from '@layouts/Layout.astro';
import Container from '@components/ui/Container.astro';
import SectionTitle from '@components/ui/SectionTitle.astro';
import Heading from '@components/ui/Heading.astro';
import Text from '@components/ui/Text.astro';
import Image from '@components/ui/Image.astro';
import { useTranslations } from '@/i18n';
import '@styles/global.css';

const t = useTranslations('ca');
---

<Layout lang="ca">
  <Container>
    <SectionTitle>{t('index.section')}</SectionTitle>
    <Heading as="h1" size="3xl" variant="primary">{t('index.title')}</Heading>

    <div class="space-y-8">
      <Image src="/images/inici_img.webp" alt={t('index.imageAlt')} aspect="auto" loading="eager">
        <span slot="caption">{t('index.caption')}</span>
      </Image>

      <Text variant="body">
        {t('index.description')}
      </Text>

      <blockquote class="border-l-4 border-accent pl-6 py-2 my-8">
        <p class="text-xl font-serif text-secondary italic">
          "Think global, act local."
          <br />
          <span class="text-sm text-muted italic"> Patrick Geddes </span>
        </p>
      </blockquote>
    </div>
  </Container>
</Layout>
