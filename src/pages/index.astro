---
import Layout from '@layouts/Layout.astro';
import '@styles/global.css';
---

<Layout>
  <main class="flex-grow pt-32 pb-16">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-xl font-serif italic mb-8 text-gray-200">INICI</h2>

      <div class="space-y-8">
        <img
          src="https://picsum.photos/1200/800"
          alt="Artistic Photography"
          class="w-full transition-opacity duration-700 hover:opacity-95"
        />
        <p class="text-sm text-gray-400 font-serif italic">Fotografia Toni Bover, 1990</p>

        <p class="text-base leading-relaxed text-gray-300">
          Aquesta web és un espai iconotextual per reflexionar sobre la comunicació visual. Els
          continguts es van ampliant al llarg del temps i tracten la relació de l'art amb la
          ciència, la semiòtica de la imatge fotogràfica, exposen temes impartits en les classes de
          cultura visual i presenten influències visuals.
        </p>
      </div>
    </div>
  </main>
</Layout>
