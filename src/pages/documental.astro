---
import Layout from '@layouts/Layout.astro';
import { YouTube } from 'astro-lazy-youtube-embed';
import '@styles/global.css';
---

<Layout>
  <main class="flex-grow pt-32 pb-16">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-xl font-serif italic mb-8 text-gray-200">DOCUMENTAL</h2>

      <div class="space-y-8">
        <YouTube title="Toni Bover. Image Manager // Xef Vila, 2020" videoId="x6hNCbrUDcc" />

        <div class="border-t border-gray-800 pt-8">
          <h3 class="text-lg font-serif mb-6 text-gray-200">Fitxa Tècnica</h3>
          <dl class="grid grid-cols-1 md:grid-cols-2 gap-4 text-gray-300">
            <div>
              <dt class="font-medium">Producció:</dt>
              <dd class="text-gray-400">Ajuntament de Vic i Fundació Puig-Porret</dd>
            </div>
            <div>
              <dt class="font-medium">Guió i Direcció:</dt>
              <dd class="text-gray-400">Xef Vila</dd>
            </div>
            <div>
              <dt class="font-medium">Música:</dt>
              <dd class="text-gray-400">Jordi Torrents</dd>
            </div>
            <div>
              <dt class="font-medium">Muntatge:</dt>
              <dd class="text-gray-400">Xef Vila</dd>
            </div>
            <div>
              <dt class="font-medium">Durada:</dt>
              <dd class="text-gray-400">35 min</dd>
            </div>
            <div>
              <dt class="font-medium">Versió Original:</dt>
              <dd class="text-gray-400">Català</dd>
            </div>
          </dl>
        </div>

        <!-- Description -->
        <div class="border-t border-gray-800 pt-8">
          <h3 class="text-lg font-serif mb-6 text-gray-200">Resum</h3>
          <p class="text-gray-300 leading-relaxed">
            Aquest documental resumeix la trajectòria professional i artística del fotògraf i
            comunicador visual Toni Bover, amb motiu de la seva jubilació. El relat mostra el seu
            recorregut des del seu endinsament cap a la professió i passa per la seva tasca en
            publicitat, els treballs artístics, la docència a la UPC i els diferents projectes de
            fotografia i urbanisme que va desenvolupar a La Farinera, Centre d'Arts Visuals de Vic,
            de la qual en va ser director fins al 2020. Addicionalment, és una reflexió sobre el
            orígens de la imatge fotogràfica, el seu present i algunes especulacions sobre el seu
            futur.
          </p>
        </div>

        <!-- Director Bio -->
        <div class="border-t border-gray-800 pt-8">
          <h3 class="text-lg font-serif mb-6 text-gray-200">Sobre el Director</h3>
          <p class="text-gray-300 leading-relaxed">
            Xef Vila (Vic, 1971), músic i realitzador audiovisual. Els seus inicis se situen en el
            món del curtmetratge Low Cost. S'endinsa en el món del vídeo digital l'any 2002 com a
            membre del grup seleccionat per al Taller Bigas Luna de Reus. Actualment dirigeix la
            seva pròpia productora on realitza audiovisuals en diversos àmbits, sobretot pel que fa
            la món al món cultural, social i a la memòria històrica.
          </p>
        </div>
      </div>
    </div>
  </main>
</Layout>
