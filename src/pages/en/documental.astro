---
import Layout from '@layouts/Layout.astro';
import Container from '@components/ui/Container.astro';
import { YouTube } from 'astro-lazy-youtube-embed';
import Heading from '@components/ui/Heading.astro';
import Text from '@components/ui/Text.astro';
import { useTranslations } from '@/i18n';
import '@styles/global.css';

const t = useTranslations('en');
---

<Layout lang="en">
  <Container>
    <div class="space-y-sp-8">
      <YouTube
        title={t('documental.videoTitle')}
        videoId="x6hNCbrUDcc"
        embedParams={{
          cc_load_policy: 1,
          cc_lang_pref: 'en',
        }}
      />

      <div class="border-t border-default pt-sp-8">
        <Heading as="h3" size="3xl" variant="secondary" class="mb-sp-6"
          >{t('documental.credits.title')}</Heading
        >
        <dl class="grid grid-cols-1 md:grid-cols-2 gap-sp-4 text-body">
          <div>
            <dt class="font-medium">{t('documental.credits.production')}</dt>
            <dd class="text-muted">{t('documental.credits.productionValue')}</dd>
          </div>
          <div>
            <dt class="font-medium">{t('documental.credits.scriptDirection')}</dt>
            <dd class="text-muted">{t('documental.credits.scriptDirectionValue')}</dd>
          </div>
          <div>
            <dt class="font-medium">{t('documental.credits.music')}</dt>
            <dd class="text-muted">{t('documental.credits.musicValue')}</dd>
          </div>
          <div>
            <dt class="font-medium">{t('documental.credits.editing')}</dt>
            <dd class="text-muted">{t('documental.credits.editingValue')}</dd>
          </div>
          <div>
            <dt class="font-medium">{t('documental.credits.duration')}</dt>
            <dd class="text-muted">{t('documental.credits.durationValue')}</dd>
          </div>
          <div>
            <dt class="font-medium">{t('documental.credits.originalVersion')}</dt>
            <dd class="text-muted">{t('documental.credits.originalVersionValue')}</dd>
          </div>
        </dl>
      </div>

      <!-- Description -->
      <div class="border-t border-default pt-sp-8">
        <Heading as="h3" size="3xl" variant="secondary" class="mb-sp-6"
          >{t('documental.summary.title')}</Heading
        >
        <Text variant="body">
          {t('documental.summary.description')}
        </Text>
      </div>

      <!-- Director Bio -->
      <div class="border-t border-default pt-sp-8">
        <Heading as="h3" size="3xl" variant="secondary" class="mb-sp-6"
          >{t('documental.director.title')}</Heading
        >
        <Text variant="body">
          {t('documental.director.bio')}
        </Text>
      </div>
    </div>
  </Container>
</Layout>
