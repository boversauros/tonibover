---
import '@styles/global.css';
import Layout from '@layouts/Layout.astro';
import PostsListLayout from '@layouts/PostsListLayout.astro';
import { getCollection } from 'astro:content';
import type { Post } from '@/types';
import type { GetStaticPathsOptions, Page } from 'astro';
import { useTranslations } from '@/i18n';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts: Post[] = await getCollection('posts', ({ data }) => data.lang === 'en');
  if (posts.length === 0) {
    const emptyPage: Page<Post> = {
      data: [],
      start: 0,
      end: -1,
      size: 6,
      total: 0,
      currentPage: 1,
      lastPage: 1,
      url: { current: '/en/reflexions' },
    };
    return [{ params: { page: undefined }, props: { page: emptyPage } }];
  }
  return paginate(posts, { pageSize: 6 });
}

const { page } = Astro.props;
const t = useTranslations('en');

const categoryEntries = await getCollection('categories');
const categories = categoryEntries
  .map((c) => ({ id: c.data.slug, name: c.data.name.en }))
  .sort((a, b) => a.name.localeCompare(b.name, 'en'));
---

<Layout lang="en">
  <PostsListLayout
    title={t('nav.reflexions')}
    categories={categories}
    page={page}
    emptyMessage={t('reflexions.empty')}
  />
</Layout>
