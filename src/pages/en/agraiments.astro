---
import Layout from '@layouts/Layout.astro';
import Container from '@components/ui/Container.astro';
import Heading from '@components/ui/Heading.astro';
import Text from '@components/ui/Text.astro';
import { useTranslations } from '@/i18n';
import '@styles/global.css';

const t = useTranslations('en');
---

<Layout lang="en">
  <Container>
    <Heading as="h1" size="4xl" variant="primary" class="text-center mb-sp-12"
      >{t('agraiments.title')}</Heading
    >

    <div class="space-y-sp-8">
      <div class="space-y-sp-4">
        <Text variant="body" class="text-primary-80">
          {t('agraiments.eva')}
        </Text>
        <Text variant="body" class="text-primary-80">
          {t('agraiments.oriol')}
        </Text>
        <Text variant="body" class="text-primary-80">
          {t('agraiments.legal')}
        </Text>
      </div>

      <Text variant="body" italic class="text-primary-80 mt-sp-8">
        {t('agraiments.closing')}
      </Text>
    </div>
  </Container>
</Layout>
