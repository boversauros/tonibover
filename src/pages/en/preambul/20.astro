---
import PreambulContentLayout from '@layouts/PreambulLayout.astro';
import Text from '@components/ui/Text.astro';
import { useTranslations } from '@/i18n';
import '@styles/global.css';

const t = useTranslations('en');

const image = {
  src: '/images/preambul-20-02.webp',
  alt: t('preambul.20.imageAlt'),
  caption: t('preambul.20.imageCaption'),
};
---

<PreambulContentLayout
  lang="en"
  title={`20 ${t('preambul.20.title')}`}
  quote={t('preambul.20.quote')}
  image={image}
>
  <Text variant="body">
    {t('preambul.20.subtitle')}
  </Text>

  <Text variant="body">
    {t('preambul.20.paragraph1')}
  </Text>

  <Text variant="body">
    {t('preambul.20.paragraph2')}
  </Text>
</PreambulContentLayout>
