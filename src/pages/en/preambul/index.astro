---
import Layout from '@layouts/Layout.astro';
import Container from '@components/ui/Container.astro';
import Heading from '@components/ui/Heading.astro';
import Text from '@components/ui/Text.astro';
import Image from '@components/ui/Image.astro';
import Icon from '@components/ui/Icon.astro';
import { useTranslations } from '@/i18n';
import '@styles/global.css';

const t = useTranslations('en');
---

<Layout lang="en">
  <Container>
    <Heading as="h1" size="3xl" variant="primary" class="text-[32px]">{t('index.title')}</Heading>

    <div class="space-y-sp-8">
      <Image src="/images/inici_img.webp" alt={t('index.imageAlt')} aspect="auto" loading="eager">
        <span
          slot="caption"
          set:html={`Toni Bover. <span class="font-serif">La llum com a metàfora del llenguatge</span>. 1990-94.`}
        />
      </Image>

      <Text variant="body">
        {t('index.description')}
      </Text>

      <blockquote class="flex gap-sp-4 py-sp-2 my-sp-8">
        <Icon name="quote-close" class="h-10 w-10 md:h-12 md:w-12 text-secondary shrink-0 mt-1" />
        <p class="text-xl font-serif text-secondary italic">
          Think global, act local.
          <br />
          <span class="text-sm text-muted italic"> Patrick Geddes </span>
        </p>
      </blockquote>
    </div>
  </Container>
</Layout>
