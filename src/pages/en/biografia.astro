---
import Layout from '@layouts/Layout.astro';
import Container from '@components/ui/Container.astro';
import Carousel from '@components/app/Carousel.astro';
import Link from '@components/ui/Link.astro';
import SectionTitle from '@components/ui/SectionTitle.astro';
import Heading from '@components/ui/Heading.astro';
import Text from '@components/ui/Text.astro';
import { useTranslations } from '@/i18n';
import '@styles/global.css';

const t = useTranslations('en');
---

<Layout lang="en">
  <Container>
    <SectionTitle>{t('biografia.section')}</SectionTitle>
    <Heading as="h1" size="3xl" variant="primary">{t('biografia.name')}</Heading>
    <Text variant="body" class="text-lg text-primary-80 mb-8">{t('biografia.birthInfo')}</Text>

    <Carousel />

    <div class="mt-12 text-sm text-primary-60 italic">
      {t('biografia.imageCaption')}
    </div>

    <div class="mt-16 space-y-12">
      <section>
        <Heading as="h3" size="2xl" variant="primary">{t('biografia.education.title')}</Heading>
        <ul class="space-y-4 text-primary-80">
          <li>
            {t('biografia.education.phd')}
            {' '}
            <Link
              href="https://upcommons.upc.edu/handle/2117/94778?show=full"
              aria-label="Tesi doctoral Toni Bover"
              rel="noopener noreferrer"
              target="_blank"
              variant="secondary"
              >{t('biografia.education.phd.link')}
            </Link>
          </li>
          <li>
            {t('biografia.education.semiotics')}
          </li>
          <li>{t('biografia.education.degree')}</li>
        </ul>
      </section>

      <section>
        <Heading as="h3" size="2xl" variant="primary">{t('biografia.teaching.title')}</Heading>
        <ul class="space-y-4 text-primary-80">
          <li>
            {t('biografia.teaching.professor')}
          </li>
          <li>
            {t('biografia.teaching.labCoordinator')}
          </li>
          <li>
            {t('biografia.teaching.postgraduateVirtual')}
          </li>
          <li>{t('biografia.teaching.postgraduatePhoto')}</li>
          <li>
            {t('biografia.teaching.professorETSAB')}
          </li>
        </ul>
      </section>

      <section>
        <Heading as="h2" size="2xl" variant="primary">{t('biografia.cultural.title')}</Heading
        >
        <ul class="space-y-4 text-primary-80">
          <li>
            {t('biografia.cultural.director')}
          </li>
          <li>{t('biografia.cultural.coDirector')}</li>
          <li>
            {t('biografia.cultural.coordinatorCiutats')}
          </li>
          <li>
            {t('biografia.cultural.coordinatorFotografia')}
          </li>
          <li>{t('biografia.cultural.professorDibuix')}</li>
        </ul>
      </section>

      <section>
        <Heading as="h2" size="2xl" variant="primary">{t('biografia.institutional.title')}</Heading>
        <ul class="space-y-4 text-primary-80">
          <li>
            {t('biografia.institutional.consellCentralitat')}
          </li>
          <li>{t('biografia.institutional.consellVic')}</li>
          <li>{t('biografia.institutional.consellTerrassa')}</li>
          <li>{t('biografia.institutional.patronat')}</li>
        </ul>
      </section>

      <section>
        <Heading as="h2" size="2xl" variant="primary">{t('biografia.other.title')}</Heading>
        <ul class="space-y-4 text-primary-80">
          <li>{t('biografia.other.professional')}</li>
          <li>
            {t('biografia.other.research')}
          </li>
        </ul>
      </section>
    </div>
  </Container>
</Layout>
