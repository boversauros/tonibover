---
import { Image as AstroImage } from 'astro:assets';

interface Props {
  src: string;
  alt: string;
  aspect?: 'square' | '4/3' | 'video' | 'auto';
  fit?: 'cover' | 'contain' | 'natural';
  hover?: 'opacity' | 'scale' | 'none';
  loading?: 'lazy' | 'eager';
  width?: string;
  height?: string;
  class?: string;
  [key: string]: any;
}

const {
  src,
  alt,
  aspect = 'auto',
  fit = 'cover',
  hover = 'opacity',
  loading = 'lazy',
  width = 'w-full',
  height = '',
  class: className = '',
  ...rest
} = Astro.props;

const hasCaption = Astro.slots.has('caption');

const aspectClasses = {
  square: 'aspect-square',
  '4/3': 'aspect-4/3',
  video: 'aspect-video',
  auto: '',
};

const hoverClasses = {
  opacity: 'group-hover:opacity-90 transition-opacity duration-700',
  scale: 'group-hover:scale-105 transition-transform duration-300',
  none: '',
};

const fitClasses = {
  cover: 'object-cover',
  contain: 'object-contain',
  natural: 'h-auto',
};

const imageClasses =
  `${width} ${height} ${aspectClasses[aspect]} ${fitClasses[fit]} ${hoverClasses[hover]} ${className}`.trim();
const overflowClass = hover === 'scale' ? 'overflow-hidden' : '';

// astro:assets <Image> can optimize remote URLs (with inferSize) but not public-folder paths.
// Local public paths (e.g. /images/foo.webp) fall through to a plain <img>.
const isRemote = /^https?:\/\//.test(src);
---

{
  hasCaption ? (
    <figure class="space-y-sp-3">
      <div class={`group ${overflowClass}`}>
        {isRemote ? (
          <AstroImage
            src={src}
            alt={alt}
            inferSize
            loading={loading}
            class={imageClasses}
            {...rest}
          />
        ) : (
          <img src={src} alt={alt} loading={loading} class={imageClasses} {...rest} />
        )}
      </div>
      <figcaption class="text-sm text-muted leading-relaxed">
        <slot name="caption" />
      </figcaption>
    </figure>
  ) : (
    <div class={`group ${overflowClass}`}>
      {isRemote ? (
        <AstroImage
          src={src}
          alt={alt}
          inferSize
          loading={loading}
          class={imageClasses}
          {...rest}
        />
      ) : (
        <img src={src} alt={alt} loading={loading} class={imageClasses} {...rest} />
      )}
    </div>
  )
}
