---
import { Menu, X, ChevronLeft, ChevronRight, ArrowLeft, ArrowRight } from '@lucide/astro';

interface Props {
  name:
    | 'menu'
    | 'close'
    | 'chevron-left'
    | 'chevron-right'
    | 'arrow-left'
    | 'arrow-right'
    | 'quote-close';
  size?: '4' | '5' | '6' | '8' | '10' | '12';
  variant?: 'outline' | 'solid';
  class?: string;
  'aria-hidden'?: 'true' | 'false';
  [key: string]: any;
}

const {
  name,
  size = '6',
  variant,
  class: className = '',
  'aria-hidden': ariaHidden = 'true',
  ...rest
} = Astro.props;

// Map size prop to pixel values for Lucide
const sizeMap: Record<string, number> = {
  '4': 16,
  '5': 20,
  '6': 24,
  '8': 32,
  '10': 40,
  '12': 48,
};

const pixelSize = sizeMap[size];

// Tailwind size classes for custom SVG icons
const sizeClasses: Record<string, string> = {
  '4': 'h-4 w-4',
  '5': 'h-5 w-5',
  '6': 'h-6 w-6',
  '8': 'h-8 w-8',
  '10': 'h-10 w-10',
  '12': 'h-12 w-12',
};

// Map icon names to Lucide components (except quote-close which uses custom SVG)
const iconComponents = {
  menu: Menu,
  close: X,
  'chevron-left': ChevronLeft,
  'chevron-right': ChevronRight,
  'arrow-left': ArrowLeft,
  'arrow-right': ArrowRight,
};

const isQuoteClose = name === 'quote-close';
const IconComponent = !isQuoteClose ? iconComponents[name as keyof typeof iconComponents] : null;
---

{
  isQuoteClose && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class={`${sizeClasses[size]} ${className}`.trim()}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden={ariaHidden}
      {...rest}
    >
      <path d="M11.3 6.2c0 2.3-.7 4.2-2.1 5.7-1.4 1.6-3.2 2.7-5.4 3.3l-.5-1.4c1.6-.6 2.8-1.4 3.7-2.4.9-1 1.4-2.1 1.6-3.3h-.4c-.9 0-1.7-.3-2.3-.9-.6-.6-.9-1.4-.9-2.4 0-1 .3-1.8.9-2.4.6-.6 1.4-.9 2.4-.9 1.2 0 2.1.4 2.7 1.2.6.8.9 1.9.9 3.3v.2zm10.7 0c0 2.3-.7 4.2-2.1 5.7-1.4 1.6-3.2 2.7-5.4 3.3l-.5-1.4c1.6-.6 2.8-1.4 3.7-2.4.9-1 1.4-2.1 1.6-3.3h-.4c-.9 0-1.7-.3-2.3-.9-.6-.6-.9-1.4-.9-2.4 0-1 .3-1.8.9-2.4.6-.6 1.4-.9 2.4-.9 1.2 0 2.1.4 2.7 1.2.6.8.9 1.9.9 3.3v.2z" />
    </svg>
  )
}
{
  !isQuoteClose && IconComponent && (
    <IconComponent size={pixelSize} class={className} aria-hidden={ariaHidden} {...rest} />
  )
}
