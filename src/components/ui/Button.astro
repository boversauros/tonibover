---
interface Props {
  variant?: 'ghost' | 'icon';
  size?: 'sm' | 'md' | 'icon';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  'aria-label'?: string;
  'aria-expanded'?: 'true' | 'false';
  [key: string]: any;
}

const {
  variant = 'ghost',
  size = 'sm',
  class: className = '',
  type = 'button',
  'aria-label': ariaLabel,
  'aria-expanded': ariaExpanded,
  ...rest
} = Astro.props;

const variantClasses = {
  ghost:
    'px-sp-4 py-sp-2 tracking-wide text-body hover:bg-surface hover:text-primary transition-all duration-300',
  icon: 'p-sp-2 hover:text-primary transition-colors-default',
};

const sizeClasses = {
  sm: 'text-sm',
  md: 'text-base',
  icon: 'h-8 w-8',
};

const finalSize = variant === 'icon' ? 'icon' : size;
const finalClasses = `${variantClasses[variant]} ${sizeClasses[finalSize]} ${className}`.trim();
---

<button
  type={type}
  class={finalClasses}
  aria-label={ariaLabel}
  aria-expanded={ariaExpanded}
  {...rest}
>
  <slot />
</button>
