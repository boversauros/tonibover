---
interface Props {
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'p';
  size?: 'xl' | '2xl' | '3xl' | '4xl' | '5xl';
  variant?: 'primary' | 'secondary' | 'body' | 'muted';
  italic?: boolean;
  class?: string;
}

const {
  as: Element = 'h2',
  size = '2xl',
  variant = 'primary',
  italic = false,
  class: className = '',
} = Astro.props;

const sizeClasses: Record<NonNullable<Props['size']>, string> = {
  xl: 'text-xl',
  '2xl': 'text-2xl',
  '3xl': 'text-3xl',
  '4xl': 'text-4xl md:text-5xl',
  '5xl': 'text-5xl',
};

const variantClasses: Record<NonNullable<Props['variant']>, string> = {
  primary: 'text-primary',
  secondary: 'text-secondary',
  body: 'text-body',
  muted: 'text-muted',
};

const marginClasses: Record<NonNullable<Props['size']>, string> = {
  xl: 'mb-sp-6',
  '2xl': 'mb-sp-6',
  '3xl': 'mb-sp-4',
  '4xl': 'mb-sp-2',
  '5xl': 'mb-sp-2',
};

const italicClass = italic ? 'italic' : '';
const fontWeightClass = Element === 'h1' ? 'font-semibold' : '';
const finalClasses =
  `font-serif ${sizeClasses[size]} ${variantClasses[variant]} ${marginClasses[size]} ${italicClass} ${fontWeightClass} ${className}`.trim();
---

<Element class={finalClasses}>
  <slot />
</Element>
