---
interface Props {
  keywords: Array<string>;
}

const { keywords } = Astro.props;
---

<div class="border-t border-default pt-8">
  <h3 class="text-lg font-serif mb-6 text-secondary">Paraules Clau</h3>
  <div class="flex flex-wrap gap-2">
    {
      keywords.map((keyword) => (
        <a
          href={`/reflexions/paraula-clau/${keyword}`}
          class="text-muted hover:text-primary transition-colors-default text-sm border-b border-transparent hover:border-primary"
        >
          {keyword}
        </a>
      ))
    }
  </div>
</div>
