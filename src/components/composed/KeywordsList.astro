---
import Link from '@components/ui/Link.astro';

interface Props {
  keywords: Array<string>;
}

const { keywords } = Astro.props;
---

<div class="border-t border-default pt-8">
  <h3 class="text-lg font-serif mb-6 text-secondary">Paraules Clau</h3>
  <div class="flex flex-wrap gap-2">
    {
      keywords.map((keyword) => (
        <Link href={`/reflexions/paraula-clau/${keyword}`} variant="accent-border" class="text-sm">
          {keyword}
        </Link>
      ))
    }
  </div>
</div>
