---
import Link from '@components/ui/Link.astro';
import { getLangFromUrl, getLocalizedPath } from '@/i18n';

interface Props {
  keywords: Array<string>;
}

const { keywords } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<div class="border-t border-default pt-sp-8">
  <h3 class="text-lg font-serif mb-sp-6 text-secondary">Paraules Clau</h3>
  <div class="flex flex-wrap gap-sp-2">
    {
      keywords.map((keyword) => (
        <Link
          href={getLocalizedPath(`/reflexions/paraula-clau/${keyword}`, lang)}
          variant="accent-border"
          class="text-sm"
        >
          {keyword}
        </Link>
      ))
    }
  </div>
</div>
