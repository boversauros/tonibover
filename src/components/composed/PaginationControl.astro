---
import type { Page } from 'astro';
import Link from '@components/ui/Link.astro';

interface Props {
  page: Page;
}

const { page } = Astro.props;
---

<nav class="flex justify-center items-center gap-8 mb-16" aria-label="Pagination">
  {
    page.url.prev && (
      <Link
        href={page.url.prev}
        variant="muted"
        class="text-sm"
        aria-label="Previous page"
      >
        ←
      </Link>
    )
  }

  <div class="flex items-center gap-4 text-sm">
    {
      Array.from({ length: page.lastPage }, (_, i) => i + 1).map((pageNum) => (
        <Link
          href={`/reflexions/${pageNum > 1 ? pageNum : ''}`}
          variant="muted"
          active={page.currentPage === pageNum}
          aria-current={page.currentPage === pageNum ? 'page' : undefined}
        >
          {pageNum}
        </Link>
      ))
    }
  </div>

  {
    page.url.next && (
      <Link
        href={page.url.next}
        variant="muted"
        class="text-sm"
        aria-label="Next page"
      >
        →
      </Link>
    )
  }
</nav>
