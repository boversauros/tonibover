---
import Link from '@components/ui/Link.astro';
import { getLocalizedPath, useTranslations, type Lang } from '@/i18n';
import type { Post } from '@/types';

interface Props {
  prevPost: Post | null;
  nextPost: Post | null;
  lang: Lang;
}

const { prevPost, nextPost, lang } = Astro.props;
const t = useTranslations(lang);

if (!prevPost && !nextPost) return null;
---

<nav class="flex justify-center items-center gap-sp-8" aria-label={t('post.nav.label')}>
  {
    prevPost && (
      <Link
        href={getLocalizedPath(`/reflexions/${prevPost.data.slug}`, lang)}
        variant="muted"
        class="text-sm"
        aria-label={`${t('post.nav.previous')}: ${prevPost.data.title}`}
      >
        ←
      </Link>
    )
  }
  {
    nextPost && (
      <Link
        href={getLocalizedPath(`/reflexions/${nextPost.data.slug}`, lang)}
        variant="muted"
        class="text-sm"
        aria-label={`${t('post.nav.next')}: ${nextPost.data.title}`}
      >
        →
      </Link>
    )
  }
</nav>
