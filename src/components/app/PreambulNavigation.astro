---
import Icon from '@components/ui/Icon.astro';
import { useTranslations, getLocalizedPath, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
  currentSection: string;
}

const { lang, currentSection } = Astro.props;
const t = useTranslations(lang);

const sections = [
  { id: '20', title: t('preambul.card20.title') },
  { id: '40', title: t('preambul.card40.title') },
  { id: '60', title: t('preambul.card60.title') },
];

const currentIndex = sections.findIndex((section) => section.id === currentSection);
const prevSection = currentIndex > 0 ? sections[currentIndex - 1] : null;
const nextSection = currentIndex < sections.length - 1 ? sections[currentIndex + 1] : null;
---

<nav class="mt-sp-16 border-t border-default/50 pt-sp-8">
  <div class="flex justify-between items-center">
    {
      prevSection && (
        <a
          href={getLocalizedPath(`/preambul/${prevSection.id}`, lang)}
          class="group flex items-center text-muted hover:text-secondary transition-colors"
        >
          <Icon
            name="arrow-left"
            size="5"
            class="mr-2 transform group-hover:-translate-x-1 transition-transform"
          />
          <span>
            <span class="block text-sm text-subtle">{t('preambul.nav.previous')}</span>
            <span class="block">{prevSection.title}</span>
          </span>
        </a>
      )
    }

    {
      nextSection && (
        <a
          href={getLocalizedPath(`/preambul/${nextSection.id}`, lang)}
          class="group flex items-center text-right text-muted hover:text-secondary transition-colors ml-auto"
        >
          <span>
            <span class="block text-sm text-subtle">{t('preambul.nav.next')}</span>
            <span class="block">{nextSection.title}</span>
          </span>
          <Icon
            name="arrow-right"
            size="5"
            class="ml-2 transform group-hover:translate-x-1 transition-transform"
          />
        </a>
      )
    }
  </div>
</nav>
