---
import Link from '@components/ui/Link.astro';
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import { defaultLang, useTranslations, getLocalizedPath, type Lang } from '@/i18n';

interface Props {
  lang?: Lang;
  currentPath?: string;
}

const { lang = defaultLang, currentPath = '/' } = Astro.props;
const t = useTranslations(lang);

const links = [
  { label: t('nav.preambul'), href: getLocalizedPath('/preambul', lang) },
  { label: t('nav.biografia'), href: getLocalizedPath('/biografia', lang) },
  { label: t('nav.documental'), href: getLocalizedPath('/documental', lang) },
  { label: t('nav.reflexions'), href: getLocalizedPath('/reflexions', lang) },
];

function isActive(href: string, path: string) {
  return path === href || (href !== '/' && path.startsWith(href + '/'));
}
---

<header class="fixed top-0 left-0 right-0 bg-nav backdrop-blur-sm z-50 border-b border-subtle">
  <nav class="max-w-6xl mx-auto px-sp-6">
    <div class="flex items-center justify-between h-20 gap-sp-8">
      <h1 class="shrink-0">
        <Link
          href={getLocalizedPath('/', lang)}
          class="group flex items-baseline gap-sp-4"
          aria-label="Toni Bover · Image Manager"
        >
          <span
            class="text-xl md:text-2xl font-serif italic font-semibold text-primary group-hover:text-secondary transition-colors-default whitespace-nowrap"
          >
            Toni Bover
          </span>
          <span
            aria-hidden="true"
            class="hidden lg:inline-block self-center h-5 border-l border-subtle"></span>
          <span
            class="hidden lg:inline-block text-sm tracking-[0.25em] text-muted whitespace-nowrap"
          >
            IMAGE MANAGER
          </span>
        </Link>
      </h1>

      <div class="hidden md:flex items-center gap-sp-6">
        {
          links.map((link) => {
            const active = isActive(link.href, currentPath);
            return (
              <Link href={link.href} underline active={active} class="text-sm tracking-wide">
                {link.label}
              </Link>
            );
          })
        }

        <span aria-hidden="true" class="h-4 border-l border-subtle"></span>

        <Link
          href="/"
          data-lang-switch
          variant="muted"
          class="text-xs tracking-wider uppercase"
          aria-label={t('nav.language')}
        >
          {t('nav.language')}
        </Link>
      </div>

      <Button
        variant="icon"
        class="md:hidden"
        data-menu-button
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <Icon name="menu" size="6" id="menuIcon" />
        <Icon name="close" size="6" id="closeIcon" class="hidden" />
      </Button>
    </div>

    <div id="mobileMenu" class="hidden md:hidden border-t border-subtle">
      <div class="py-sp-4 space-y-sp-2">
        {
          links.map((link) => {
            const active = isActive(link.href, currentPath);
            return (
              <Link
                href={link.href}
                underline
                active={active}
                class="block px-sp-4 py-sp-2 text-sm tracking-wide hover:bg-surface transition-all duration-300"
              >
                {link.label}
              </Link>
            );
          })
        }
        <div class="mt-sp-2 pt-sp-2 border-t border-subtle"></div>
        <Link
          href="/"
          data-lang-switch
          variant="muted"
          class="block px-sp-4 py-sp-2 text-xs tracking-wider uppercase hover:bg-surface transition-all duration-300"
        >
          {t('nav.language')}
        </Link>
      </div>
    </div>
  </nav>
</header>

<script>
  const button = document.querySelector('[data-menu-button]');
  const mobileMenu = document.getElementById('mobileMenu');
  const menuIcon = document.getElementById('menuIcon');
  const closeIcon = document.getElementById('closeIcon');

  if (button && mobileMenu && menuIcon && closeIcon) {
    button.addEventListener('click', () => {
      const isMenuOpen = mobileMenu.classList.contains('hidden');

      mobileMenu.classList.toggle('hidden');
      menuIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');

      button.setAttribute('aria-expanded', String(isMenuOpen));
    });
  }
</script>
