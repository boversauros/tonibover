---
import type { Post } from '@/types';
import Card from '@components/ui/Card.astro';
import Image from '@components/ui/Image.astro';
import { formatPostNumber, postIdFromEntryId } from '@/lib/format-post-number';
import { getLangFromUrl, getLocalizedPath } from '@/i18n';

interface Props {
  posts: Array<Post>;
  categories: Array<{ id: string; name: string }>;
}

const { posts, categories } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-sp-8 mb-sp-16">
  {
    posts.map((post) => (
      <Card
        href={getLocalizedPath(`/reflexions/${post.data.slug}`, lang)}
        as="article"
        aria-label={`Read ${post.data.title}`}
      >
        <Image
          slot="image"
          src={post.data.thumbnail.url}
          alt={post.data.thumbnail.alt}
          aspect="4/3"
          hover="scale"
        />
        <div class="space-y-2 pt-4">
          <div class="flex items-baseline justify-between gap-sp-4">
            <p class="text-sm text-muted font-serif">
              {categories.find((c) => c.id === post.data.category)?.name}
            </p>
            <p class="text-sm font-serif text-primary-80 font-normal tabular-nums shrink-0">
              {formatPostNumber(postIdFromEntryId(post.id))}
            </p>
          </div>
          <h3 class="text-lg font-serif text-secondary group-hover:text-primary transition-colors-default">
            {post.data.title}
          </h3>
        </div>
      </Card>
    ))
  }
</div>
